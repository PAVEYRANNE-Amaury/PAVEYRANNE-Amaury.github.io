---
title: "Page not found"
---

::: {#not-found}
This page doesn't exist. [Back to home](/)
:::

```{=html}
<script>
document.addEventListener("DOMContentLoaded", () => {
  const path = window.location.pathname;
  const cur = currentLang(path);
  const t = I18N[cur];
  if (cur === DEFAULT_LANG || !t) return;
  document.querySelector("h1.title").textContent = t["404.title"];
  document.getElementById("not-found").innerHTML =
    `<p>${t["404.text"]}</p>
     <p><a href="${stripLang(path, cur)}">${t["404.original"]}</a> ·
        <a href="${withLang("/", cur)}">${t["404.home"]}</a></p>`;
});
</script>
```